# Variables usadas directamente por docker-compose.yml (nivel infraestructura).
# Copia este archivo como ".env" en la raíz del proyecto y ajusta los valores.

# Contraseñas de las bases de datos internas (Mongo/Redis solo son accesibles
# dentro de la red de Docker, no se exponen a internet)
MONGO_PASSWORD=cambia_esto
REDIS_PASSWORD=cambia_esto

# Carpetas del host donde se guardan las sesiones de WhatsApp y los archivos
# subidos (fotos, PDFs) — se montan como volumen dentro del contenedor backend
SESSIONS_DIR=./sessions
UPLOADS_DIR=./uploads
