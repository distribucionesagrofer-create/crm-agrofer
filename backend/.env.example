# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://admin:drako2024@mongodb:27017/drakocrm?authSource=admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=drako2024

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_64_chars
JWT_EXPIRES_IN=7d

# OpenAI (bot con IA / tool-calling) — fallback si no hay key guardada en
# Ajustes > IA (SystemConfig.openaiKey, que tiene prioridad sobre esta variable)
OPENAI_API_KEY=sk-...

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# URL pública HTTPS del backend (ngrok en dev, dominio real en producción).
# Requerida para enviar adjuntos (imagen/video/audio/documento) por Meta API,
# que exige un link públicamente accesible en vez de subir el archivo directo.
PUBLIC_URL=https://tu-dominio-o-ngrok.example.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# API key del Sistema Principal (ERP externo de AGROFER — clientes, productos, pedidos)
SP_API_KEY=
